{
  "name": "qraft-qr",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "build:sites": "opennextjs-cloudflare build --skipWranglerConfigCheck && wrangler deploy .open-next/worker.js --dry-run --outdir .sites-worker --compatibility-date 2025-03-01 --compatibility-flags nodejs_compat --assets .open-next/assets --name qraft-qr-generator && node scripts/prepare-sites-build.mjs",
    "start": "next start",
    "lint": "eslint .",
    "test": "node --test tests/*.test.mts"
  },
  "dependencies": {
    "next": "^16.2.11",
    "qrcode": "1.5.4",
    "react": "19.2.6",
    "react-dom": "19.2.6"
  },
  "devDependencies": {
    "@eslint/js": "9.39.4",
    "@next/eslint-plugin-next": "^16.2.11",
    "@opennextjs/cloudflare": "^1.20.2",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/qrcode": "1.5.6",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "eslint": "9.39.4",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "16.4.0",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "typescript-eslint": "8.59.3",
    "wrangler": "^4.120.0"
  }
}
