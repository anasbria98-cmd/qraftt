{
  "name": "qraft-qr",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "next dev",
    "dev:sandbox": "node --env-file=.env.sandbox.local node_modules/next/dist/bin/next dev --hostname 127.0.0.1 --port 3017",
    "dev:template-review": "QRAFTT_LOCAL_TEMPLATE_REVIEW=1 next dev --hostname 127.0.0.1 --port 3017",
    "build": "next build",
    "build:sites": "opennextjs-cloudflare build --skipWranglerConfigCheck && wrangler deploy .open-next/worker.js --dry-run --outdir .sites-worker --compatibility-date 2025-03-01 --compatibility-flags nodejs_compat --assets .open-next/assets --name qraft-qr-generator && node scripts/prepare-sites-build.mjs",
    "start": "next start",
    "lint": "eslint .",
    "test": "node --test tests/*.test.mts"
  },
  "dependencies": {
    "@libsql/client": "^0.18.0",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.118.0",
    "@vercel/analytics": "^2.0.1",
    "fast-xml-parser": "^5.11.2",
    "next": "^16.4.2",
    "pdfkit": "^0.20.2",
    "qrcode": "1.5.4",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "server-only": "^0.0.1",
    "sharp": "^0.35.5",
    "svg-to-pdfkit": "^0.1.8",
    "svgpath": "^2.6.0"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.11",
    "@eslint/js": "9.39.4",
    "@next/eslint-plugin-next": "^16.4.2",
    "@opennextjs/cloudflare": "^1.20.2",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/pdfkit": "^0.17.7",
    "@types/qrcode": "1.5.6",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@types/svg-to-pdfkit": "^0.1.4",
    "eslint": "9.39.4",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "16.4.0",
    "jsqr": "1.4.0",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "typescript-eslint": "8.59.3",
    "wrangler": "^4.120.0"
  }
}
