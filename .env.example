# Optional Google integrations. Leave blank to keep them disabled.
NEXT_PUBLIC_GA_ID=
NEXT_PUBLIC_ADSENSE_CLIENT_ID=

# AdSense ad-unit slot IDs for the three restrained placements.
NEXT_PUBLIC_ADSENSE_GENERATOR_SLOT_ID=
NEXT_PUBLIC_ADSENSE_CONTENT_SLOT_ID=
NEXT_PUBLIC_ADSENSE_ARTICLE_SLOT_ID=

# PayPal Sandbox only. Keep secrets in .env.local or Vercel Secrets, never in source.
NEXT_PUBLIC_PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_ENV=sandbox
PAYPAL_SUBSCRIPTION_PLAN_ID=
PAYPAL_WEBHOOK_ID=
PAYPAL_PRO_MONTHLY_PLAN_ID=
PAYPAL_PRO_YEARLY_PLAN_ID=
# Optional temporary monthly checkout override: development + Sandbox only.
PAYPAL_SANDBOX_TEST_PLAN_ID=
# Production-environment Sandbox tests only; leave false outside explicit test runs.
PAYPAL_SANDBOX_PRODUCTION_TEST=false
# Legacy anonymous Sandbox store only; not used for account Pro entitlements.
BILLING_DATABASE_URL=
BILLING_DATABASE_AUTH_TOKEN=

# Supabase Auth and database. Never prefix the server key with NEXT_PUBLIC_.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Server-only secret for the daily unclaimed Sandbox subscription cleanup.
CRON_SECRET=
# Local auth email callback origin; set the canonical origin before production.
AUTH_SITE_URL=http://localhost:3000
